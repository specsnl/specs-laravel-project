# Dev environment
COMPOSE_PROJECT_NAME="[[ .ProjectShortName | toKebabCase ]]"

DOCKER_NGINX_PORT=8080
[[ eq .Database "postgres" | ternary "DOCKER_POSTGRES_PORT" (eq .Database "mysql" | ternary "DOCKER_MYSQL_PORT" "DOCKER_MARIADB_PORT") ]]=[[ .DockerDbPort]]
DOCKER_REDIS_PORT=6379
DOCKER_MAILPIT_PORT=8025

[[- if eq .Database "postgres" ]]

# PostgreSQL container
POSTGRES_DB="[[ .DbDatabase ]]"
POSTGRES_USER="[[ .DbUsername ]]"
POSTGRES_PASSWORD="[[ .DbPassword ]]"
[[- else if eq .Database "mysql" ]]

# MySQL container
MYSQL_DATABASE="[[ .DbDatabase ]]"
MYSQL_USER="[[ .DbUsername ]]"
MYSQL_PASSWORD="[[ .DbPassword ]]"
MYSQL_ROOT_PASSWORD="[[ .DbPassword ]]"
[[- else ]]

# MariaDB container
MARIADB_DATABASE="[[ .DbDatabase ]]"
MARIADB_USER="[[ .DbUsername ]]"
MARIADB_PASSWORD="[[ .DbPassword ]]"
MARIADB_ROOT_PASSWORD="[[ .DbPassword ]]"
[[- end]]

# Laravel
APP_NAME="[[ .ProjectName ]]"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION="[[ .DbConnection ]]"
DB_HOST="[[ .DbHost ]]"
DB_PORT="[[ .DbPort ]]"
DB_DATABASE="[[ eq .Database "postgres" | ternary "${POSTGRES_DB}" (eq .Database "mysql" | ternary "${MYSQL_DATABASE}" "${MARIADB_DATABASE}") ]]"
DB_USERNAME="[[ eq .Database "postgres" | ternary "${POSTGRES_USER}" (eq .Database "mysql" | ternary "${MYSQL_USER}" "${MARIADB_USER}") ]]"
DB_PASSWORD="[[ eq .Database "postgres" | ternary "${POSTGRES_PASSWORD}" (eq .Database "mysql" | ternary "${MYSQL_PASSWORD}" "${MARIADB_PASSWORD}") ]]"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="info@[[ .ProjectShortName | toKebabCase ]].local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

[[- if eq .AddBugSnag true ]]

# Bugsnag
BUGSNAG_API_KEY=
BUGSNAG_NOTIFY_RELEASE_STAGES=disabled
# BUGSNAG_APP_VERSION=
[[- end ]]
