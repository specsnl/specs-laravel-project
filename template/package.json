{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "[[ .ProjectName | toKebabCase ]]",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "watch": "vite build --watch",
        "dev": "vite"[[ if .AddE2E ]],
        "test:e2e:install": "playwright install --with-deps chromium",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:debug": "playwright test --debug",
        "test:e2e:report": "playwright show-report",
        "test:e2e:codegen": "npx playwright codegen --viewport-size=1920,1080"[[ end ]]
    },
    "devDependencies": {
        [[- if .AddE2E ]]
        "@playwright/test": "^1.61.0",
        "@types/node": "^24.0.0",
        [[- end ]]
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "laravel-vite-plugin": "^3.1.0",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.13"
    },
    "packageManager": "npm@11.17.0+sha512.3eeaf18997b11070d313849268b23766b9db0068997dec9471073170fe43fa17f2b4d0337bf0f52330ee2274e7f5754b21b01052742e48f5c9c74d8b1e32ef43",
    "engines": {
        "node": ">=24.0.0"
    }
}
