{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "[[ .ProjectName | toKebabCase ]]",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "watch": "vite build --watch",
        "dev": "vite"[[ if .AddE2E ]],
        "test:e2e:install": "playwright install --with-deps chromium",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:debug": "playwright test --debug",
        "test:e2e:report": "playwright show-report",
        "test:e2e:codegen": "playwright codegen --viewport-size=1920,1080"[[ end ]]
    },
    "devDependencies": {
        [[- if .AddE2E ]]
        "@playwright/test": "^1.65.1",
        "@types/node": "^26.0.0",
        [[- end ]]
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "laravel-vite-plugin": "^3.1.0",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.13"
    },
    "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
    "engines": {
        "node": ">=26.0.0"
    }
}
