{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "[[ .ProjectName | toKebabCase ]]",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "watch": "vite build --watch",
        "dev": "vite"[[ if .AddE2E ]],
        "test:e2e:install": "playwright install --with-deps chromium",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:debug": "playwright test --debug",
        "test:e2e:report": "playwright show-report",
        "test:e2e:codegen": "npx playwright codegen --viewport-size=1920,1080"[[ end ]]
    },
    "devDependencies": {
        [[- if .AddE2E ]]
        "@playwright/test": "^1.61.0",
        "@types/node": "^24.0.0",
        [[- end ]]
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "laravel-vite-plugin": "^3.1.0",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.13"
    },
    "packageManager": "npm@11.21.0+sha512.668bfc2a16a63677a22dd10bb63e5800bb4d9895b82f87c22d3ce37e9cd71b6c3a3121dc7f453181d94ae6e9680ae92c593fbb986514ef08bbf5c3ba46a8af3e",
    "engines": {
        "node": ">=24.0.0"
    }
}
