{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "[[ .ProjectName | toKebabCase ]]",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "watch": "vite build --watch",
        "dev": "vite"[[ if .AddE2E ]],
        "test:e2e:install": "playwright install --with-deps chromium",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:debug": "playwright test --debug",
        "test:e2e:report": "playwright show-report",
        "test:e2e:codegen": "npx playwright codegen --viewport-size=1920,1080"[[ end ]]
    },
    "devDependencies": {
        [[- if .AddE2E ]]
        "@playwright/test": "^1.65.1",
        "@types/node": "^26.0.0",
        [[- end ]]
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "laravel-vite-plugin": "^3.1.0",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.13"
    },
    "packageManager": "npm@11.21.2+sha512.ec73c0a64f807e53146af4ac78bd4f9ba0a762a3081e4e77c7e2a6ba1aa64c3a8f9233cc8312294cf713aac13dd4428dc3880504957d7e75e249d1a6d435eaf4",
    "engines": {
        "node": ">=26.0.0"
    }
}
